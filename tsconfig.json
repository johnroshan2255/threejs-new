{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Only these ambient type packages are loaded.
       Without this, every folder under node_modules/@types is pulled in
       implicitly — and one unresolvable folder (a stray "@types/three 2" copy
       from Finder) makes tsc fail with TS2688 and stop type-checking the project
       entirely, so `tsc --noEmit` exits reporting nothing while real errors go
       unseen. Listing them explicitly keeps a stray directory from ever
       silencing the check again. */
    "types": ["three", "dat.gui"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
